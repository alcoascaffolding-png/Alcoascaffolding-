{
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install --prefix frontend",
  "framework": null,
  "trailingSlash": false,
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=8192"
    }
  },
  "redirects": [
    {
      "source": "/alcoa-scaffolding",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/aluminum-scaffolding-abu-dhabi",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/construction-scaffolding-uae",
      "permanent": true
    },
    {
      "source": "/aluminum-scaffolding-dubai",
      "destination": "/aluminum-scaffolding-abu-dhabi",
      "permanent": true
    },
    {
      "source": "/services/aluminium-scaffolding",
      "destination": "/products/aluminium-scaffolding",
      "permanent": true
    },
    {
      "source": "/services/safety-inspections",
      "destination": "/services/inspections",
      "permanent": true
    },
    {
      "source": "/services/installation-setup",
      "destination": "/services/installation",
      "permanent": true
    },
    {
      "source": "/services/steel-cup-lock-scaffolding",
      "destination": "/products/steel-cuplock-scaffolding",
      "permanent": true
    },
    {
      "source": "/services/single-width-mobile-towers",
      "destination": "/services/single-width-scaffolding",
      "permanent": true
    },
    {
      "source": "/services/double-width-mobile-towers",
      "destination": "/services/double-width-scaffolding",
      "permanent": true
    },
    {
      "source": "/services/bridgeway-mobile-towers",
      "destination": "/services/bridge-scaffolding",
      "permanent": true
    },
    {
      "source": "/services/folding-mobile-towers",
      "destination": "/services/folding-tower",
      "permanent": true
    },
    {
      "source": "/services/stairway-mobile-towers",
      "destination": "/services/stairway-scaffolding",
      "permanent": true
    },
    {
      "source": "/blog/scaffolding-rental-cost-dubai-2026",
      "destination": "/blog/scaffolding-rental-cost-abu-dhabi-2026",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
